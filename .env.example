# AgentForge Dashboard runs entirely on a deterministic simulation engine, so no API keys or
# backend are needed to develop, test, build, or run the demo.

# Simulation seed (change to generate a different but still deterministic fleet).
AGENTFORGE_SEED=42

# The dashboard is designed so the UI can later connect to a real agent telemetry backend.
# When that exists, point it here. Never commit real credentials.
# AGENTFORGE_API_URL=
